@model WebAppBackend.ViewModels.Pages.PageViewModel

@{
    ViewData["Title"] = "Delete a Page";
}

<section class="container my-4">
    <div class="card shadow-sm border-danger">

        <div class="card-header bg-danger text-white">
            <h2 class="mb-0">Delete Confirmation</h2>
        </div>

        <div class="p-4">

            <h3 class="mb-4 border-bottom border-danger pb-2">
                Are you sure you want to delete
                <strong>@Model.Title</strong>?
            </h3>

            <dl class="row">

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(m => m.Title)
                </dt>

                <dd class="col-sm-10">
                    @Html.DisplayFor(m => m.Title)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(m => m.Body)
                </dt>

                <dd class="col-sm-10 PageContainer">
                    @Html.Raw(Model.Body)
                </dd>

                <dt class="col-sm-2 fw-semibold">
                    Child Pages
                </dt>

                <dd class="col-sm-10">

                    @if (Model.Children.Any())
                    {
                        <div class="alert alert-warning">
                            Deleting this page will orphan its direct child pages.
                        </div>

                        <ul class="list-group">
                            @foreach (var child in Model.Children)
                            {
                                <li class="list-group-item">
                                    @child.Title
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">
                            This page has no child pages.
                        </span>
                    }

                </dd>

            </dl>

        </div>

        <div class="card-footer d-flex justify-content-between">

            <form asp-action="Delete" method="post" class="mb-0">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash mr-1"></i>
                    Delete
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </div>
</section>
