@model PageIndexViewModel

@{
    ViewData["Title"] = "Page Index";
}

<section class="container-fluid my-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@ViewData["Title"]</h1>

        <a asp-controller="Page"
           asp-action="Create"
           class="btn btn-success">
            <i class="bi bi-plus-lg mr-1"></i>
            New Page
        </a>
    </div>

    @Html.AntiForgeryToken()

    <!-- Normal page hierarchy -->
    <div class="page-tree">
        @foreach (var item in Model.Pages)
        {
            <partial name="_PageRow" model="item" />
        }
    </div>


    <!-- Orphaned pages -->
    @if (Model.OrphanedPages.Any())
    {
        <section class="orphaned-pages mt-5">

            <div class="mb-3">
                <h2 class="mb-1">
                    Orphaned Pages
                </h2>

                <p class="text-muted mb-0">
                    These pages no longer have a valid parent.
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle text-center">

                    <thead class="thead-dark">
                        <tr>
                            <th>Page</th>
                            <th class="table-fit">Visibility</th>
                            <th class="table-fit">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var orphan in Model.OrphanedPages)
                        {
                            <partial name="_OrphanPageRow" model="orphan" />
                        }
                    </tbody>

                </table>
            </div>

        </section>
    }

</section>

@section Styles {
    <link href="~/css/page.css" rel="stylesheet" />
}

@section Scripts {
    <script>
        async function movePage(pageId, direction, button) {
            const page = document.getElementById(`page-${pageId}`);

            if (!page) {
                return;
            }

            const parent = page.parentElement;

            if (!parent) {
                return;
            }

            const sibling =
                direction === "up"
                    ? page.previousElementSibling
                    : page.nextElementSibling;

            if (!sibling || !sibling.classList.contains("page-item")) {
                return;
            }

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

            if (!token) {
                console.error("Antiforgery token was not found.");
                return;
            }

            const url =
                direction === "up"
                    ? '@Url.Action("MoveUp", "Page")'
                    : '@Url.Action("MoveDown", "Page")';

            const body = new URLSearchParams();

            body.append("id", pageId);
            body.append("__RequestVerificationToken", token);

            button.disabled = true;

            try {
                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded; charset=UTF-8"
                    },
                    body: body
                });

                if (!response.ok) {
                    throw new Error(
                        `Move request failed: ${response.status}`
                    );
                }

                if (direction === "up") {
                    parent.insertBefore(page, sibling);
                }
                else {
                    parent.insertBefore(sibling, page);
                }

                button.focus();

                updateMoveButtons(parent);
            }
            catch (error) {
                console.error(error);
            }
            finally {
                button.disabled = false;
            }
        }

        function updateMoveButtons(container) {
            const pages = Array.from(
                container.children
            ).filter(element =>
                element.classList.contains("page-item")
            );

            pages.forEach((page, index) => {
                const moveUpButton =
                    page.querySelector(".move-up");

                const moveDownButton =
                    page.querySelector(".move-down");

                if (moveUpButton) {
                    moveUpButton.hidden = index === 0;
                }

                if (moveDownButton) {
                    moveDownButton.hidden =
                        index === pages.length - 1;
                }
            });
        }
    </script>
}